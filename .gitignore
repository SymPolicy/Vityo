# Better Plan runtime lock state is host-local; never commit it.
**/.better-plan.lock

# Ephemeral browser-tool captures are host-local state.
products/vityo_app/.playwright-cli/

# Signing credentials and signature databases are never committable,
# anywhere in the repository (hoisted from the retired frontend tree).
**/*.keystore
**/*.jks
**/.sconsign.dblite
/.impeccable/
/reference-images/
/artifacts/
/docs/review/interactive-editor-input/*.png
/docs/review/interactive-editor-input/*.jpg
/prototype/*.png

# Generated diagnostics and test-failure dumps must never enter an
# outgoing range; they are mirrored by scripts/vityo_privacy.py exclusions.
products/vityo_app/test/failures/
*.trace
*.jsonl
